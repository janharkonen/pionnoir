---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Pion Noir">
  <main class="mx-auto flex min-h-[calc(100vh-89px)] max-w-6xl flex-col justify-between px-6 py-16">
    <section class="flex flex-1 items-center">
      <div>
        <h1 class="max-w-4xl text-5xl font-semibold tracking-tight text-white md:text-7xl">
          Pion Noir on holding-yhtiö
        </h1>
        <p class="mt-6 text-xl text-neutral-400 md:text-2xl">
          jonka omistaa Jan Härkönen
        </p>
      </div>
    </section>

    <footer class="grid gap-3 pt-16 text-sm text-neutral-400 md:grid-cols-4">
      <a href="https://www.janharkonen.fi" class="hover:text-white">www.janharkonen.fi</a>
      <a href="mailto:jan.harkonen@pionnoir.fi" class="hover:text-white">jan.harkonen@pionnoir.fi</a>
      <a href="tel:+358504646745" class="hover:text-white">+358504646745</a>
      <p>Y-tunnus 3629911-2</p>
    </footer>
  </main>
</Layout>
